{
  "name": "barreiros-superwhisper",
  "version": "0.1.0",
  "description": "Application to capture audio, transcribe locally with Whisper, and paste text.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "npm run build:css && electron .",
    "watch:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./style.css -o ./output.css --watch",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./style.css -o ./output.css",
    "dev": "concurrently --kill-others-on-fail \"npm:watch:css\" \"cross-env NODE_ENV=development electron .\"",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "whisper",
    "speech-to-text",
    "transcription",
    "dictation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dotenv": "^16.4.7",
    "electron-store": "^10.0.1",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.91.0"
  },
  "build": {
    "appId": "com.barreiros.superwhisper",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "files": [
      "main.js",
      "src/",
      "index.html",
      "transcription.html",
      "renderer.js",
      "transcriptionRenderer.js",
      "output.css",
      "assets/",
      "node_modules/",
      "!.env"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
